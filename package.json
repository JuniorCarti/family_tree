{
  "name": "lineage-family-tree",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack family tree application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:boot-state && npm run test:service-worker && npm run test:tree-layout && npm run test:family-access && npm run test:memories && npm run test:legacy-migration",
    "test:boot-state": "node --test tests/boot-state.test.js",
    "test:service-worker": "node --test tests/service-worker.test.js",
    "test:tree-layout": "node --test tests/tree-layout.test.js",
    "test:family-access": "node --test tests/family-sharing.test.js",
    "test:memories": "node --test tests/memories.test.js",
    "test:legacy-migration": "node --test tests/legacy-migration.test.js"
    ,"test:firebase": "node --test tests/firebase-contract.test.js"
    ,"test:firebase:rules": "firebase emulators:exec --project family-tree-a4c4f \"node --test tests/firebase-rules.test.js\""
    ,"test:firebase:crud": "firebase emulators:exec --project family-tree-a4c4f \"node --test tests/firebase-crud.test.js\""
    ,"test:firebase:emulator": "firebase emulators:exec --project family-tree-a4c4f \"npm run test:firebase\""
    ,"bootstrap:superadmin": "node scripts/bootstrap-superadmin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "adm-zip": "^0.6.0",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.4",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  }
}
