DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SESSION_SECRET=replace_with_a_long_random_secret
# Set to false only for a trusted local PostgreSQL server without TLS.
# DATABASE_SSL=false
# New signups remain locked until a superadmin verifies a KES 500 M-Pesa payment.
SUPERADMIN_EMAILS=owner@example.com
ACCOUNT_UNLOCK_FEE_KES=500
MPESA_PAYMENT_PHONE=254113245740

# Public URL used in verification and password-reset emails.
PUBLIC_APP_URL=https://family-tree-a4c4f.web.app

# SMTP delivery is required before enabling new signups in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASSWORD=replace_me
EMAIL_FROM=Lineage <no-reply@example.com>

# Google Cloud Storage bucket for durable private family media.
# When omitted, uploads use local disk for development only.
MEDIA_BUCKET=family-tree-a4c4f-media
