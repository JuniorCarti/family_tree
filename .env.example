# Firebase-native runtime uses Application Default Credentials in Functions and
# Firebase client configuration in the Hosting app. Do not add service-account
# private keys or database URLs here.
FIREBASE_PROJECT_ID=family-tree-a4c4f
FIREBASE_STORAGE_BUCKET=family-tree-a4c4f-media
# Emulator-only overrides (optional):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Application policy/configuration (use Secret Manager for sensitive values).
SUPERADMIN_EMAILS=owner@example.com
ACCOUNT_UNLOCK_FEE_KES=500
MPESA_PAYMENT_PHONE=254113245740

# Public URL used in verification and password-reset emails.
PUBLIC_APP_URL=https://family-tree-a4c4f.web.app

# SMTP is only needed for custom notifications; Firebase Auth owns reset and verification.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASSWORD=replace_me
EMAIL_FROM=Lineage <no-reply@example.com>

# Legacy DATABASE_URL/SESSION_SECRET values are intentionally not part of the
# Firebase runtime. Keep them only in an isolated, temporary recovery environment.
